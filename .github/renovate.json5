{
  "extends": [
    "github>busybeaver/homelab-shared//.github/renovate.json5",
    ":docker",
    "docker:pinDigests",
    "docker:enableMajor",
    "regexManagers:dockerfileVersions",
  ],
  // supply-chain cooldown: an update waits until its release is 3 days old; with "strict" internal checks, Renovate
  // creates no branch (and no CI run with the new dependency) before that; the shared preset sets the age per update
  // type (minor/patch/digest 3 days, major 5 days), this default covers all other update types
  "minimumReleaseAge": "3 days",
  "internalChecksFilter": "strict",
  // the shared preset enables rollback PRs; they proposed downgrades whenever a datasource no longer listed a pinned
  // version (e.g. #1616, #1624)
  "rollbackPrs": false,
  "pip_requirements": {
    // https://docs.renovatebot.com/python/#alternative-file-names
    "fileMatch": [
      "^\\.github/workflows/.+\\.pip$",
    ]
  },
  "regexManagers": [
    {
      // adopted from:
      // https://github.com/renovatebot/renovate/blob/main/lib/config/presets/internal/regex-managers.ts
      // https://docs.renovatebot.com/presets-regexManagers/#regexmanagersdockerfileversions
      // https://docs.renovatebot.com/modules/manager/regex/
      description: "Update '_VERSION' variables in shell scripts.",
      "fileMatch": [
        "^scripts/.+\\.sh$",
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+?) depName=(?<depName>[^\\s]+?)(?: (lookupName|packageName)=(?<packageName>[^\\s]+?))?(?: versioning=(?<versioning>[a-z-0-9]+?))?\\s.+?_VERSION=\"?(?<currentValue>.+?)@(?<currentDigest>sha256:[a-f0-9]+)\"?\\s"
      ]
    }
  ],
    "packageRules": [
    {
      "description": "goss and dcgoss come from the same release (mise.toml)",
      "groupName": "goss",
      "matchPackageNames": [
        "goss-org/goss"
      ]
    },
    {
      "groupName": "Caddy Docker containers",
      "matchDatasources": [
        "docker"
      ],
      "matchPackagePrefixes": [
        "caddy"
      ]
    },
  ],
}
